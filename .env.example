# Local-development settings for docker/docker-compose.yml. Every value has a default in the
# compose file, so this file is optional. Never put production secrets here.

# Kafka
KAFKA_IMAGE=apache/kafka:3.9.0
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
KAFKA_HOST_PORT=9092
KAFKA_TOPIC_PARTITIONS=3

# Event generator: days of history replayed on first start, then live traffic speed-up
BACKFILL_DAYS=30
LIVE_RATE_MULTIPLIER=30

# Spark
SPARK_WORKER_CORES=4
SPARK_WORKER_MEMORY=4g
BRONZE_TRIGGER_INTERVAL=20 seconds

# Airflow (local demo credentials)
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_SECRET_KEY=local-development-only

# Host ports (all bound to 127.0.0.1)
AIRFLOW_HOST_PORT=8080
KAFKA_UI_PORT=8082
SPARK_MASTER_UI_PORT=8090
SPARK_WORKER_UI_PORT=8091
SPARK_STREAMING_UI_PORT=4040
REPORT_PORT=8501

# AI agent: any OpenAI-compatible chat-completions provider (default: OpenRouter free model)
OPENROUTER_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free
AI_SERVER_PORT=8000
